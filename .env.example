# Tarazu runs fully without any key (DEMO_MODE): voice uses the browser's free
# built-in speech, and Tara (the helper) answers from the offline brain.
DEMO_MODE=true

# OPTIONAL, FREE: a Google AI Studio key (free tier, no card) makes Tara answer
# open-ended questions. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
